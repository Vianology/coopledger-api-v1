    "bullmq": "^5.76.5",
    "cloudinary": "^2.10.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "ethers": "^6.16.0",
    "express": "^5.2.1",
    "fedapay": "^1.2.5",
    "ioredis": "^5.10.1",
    "morgan": "^1.10.1",
    "multer": "^2.1.1",
    "pinata": "^2.5.6",
